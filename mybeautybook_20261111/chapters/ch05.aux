\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Purging. Each training observation is paired with the 12-month return that follows it. Observations whose 12-month target runs past the forecast date (dashed) contain returns the forecaster could not yet know, so they are removed from the training set.}}{61}{figure.caption.23}\protected@file@percent }
\newlabel{fig:05-purging}{{4.2}{61}{Purging. Each training observation is paired with the 12-month return that follows it. Observations whose 12-month target runs past the forecast date (dashed) contain returns the forecaster could not yet know, so they are removed from the training set}{figure.caption.23}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.5}Embargoing}{61}{subsection.4.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Five-fold cross-validation. The sample is split into five folds, and in each round the model is trained on four folds and tested on the fifth. Except in the last round, some training data come after the test fold.}}{62}{figure.caption.24}\protected@file@percent }
\newlabel{fig:05-kfold}{{4.3}{62}{Five-fold cross-validation. The sample is split into five folds, and in each round the model is trained on four folds and tested on the fifth. Except in the last round, some training data come after the test fold}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Purging and embargoing. In cross-validation, training data surround the test fold, so observations are purged before it and embargoed after it. In a walk-forward evaluation, training data come only before the forecast, so purging alone is enough.}}{62}{figure.caption.25}\protected@file@percent }
\newlabel{fig:05-embargo}{{4.4}{62}{Purging and embargoing. In cross-validation, training data surround the test fold, so observations are purged before it and embargoed after it. In a walk-forward evaluation, training data come only before the forecast, so purging alone is enough}{figure.caption.25}{}}
