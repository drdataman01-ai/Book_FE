\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Walk-forward evaluation. At each step the model is estimated on the light bar and forecasts the dark one; then the evaluation moves forward one period. An expanding window keeps all past data; a rolling window keeps a fixed length and drops the oldest observations.}}{59}{figure.caption.22}\protected@file@percent }
\newlabel{fig:05-windows}{{4.1}{59}{Walk-forward evaluation. At each step the model is estimated on the light bar and forecasts the dark one; then the evaluation moves forward one period. An expanding window keeps all past data; a rolling window keeps a fixed length and drops the oldest observations}{figure.caption.22}{}}
