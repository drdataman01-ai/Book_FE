\@writefile{lof}{\contentsline {figure}{\numberline {6.2}{\ignorespaces Net return against one-way trading cost, from the turnover and gross returns in the table. Each line falls at a rate of four times the strategy's turnover; it crosses zero at the break-even cost. Value's line is nearly flat and crosses zero off the chart, at about 4\%.}}{97}{figure.caption.36}\protected@file@percent }
\newlabel{fig:06-breakeven}{{6.2}{97}{Net return against one-way trading cost, from the turnover and gross returns in the table. Each line falls at a rate of four times the strategy's turnover; it crosses zero at the break-even cost. Value's line is nearly flat and crosses zero off the chart, at about 4\%}{figure.caption.36}{}}
\newlabel{eq:06-impact}{{6.3}{97}{Market impact and capacity}{equation.6.6.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6.3}{\ignorespaces Square-root market impact for a stock with 2\% daily volatility, from Equation~\eqref  {eq:06-impact} with $Y = 1$. Ten times the order size costs about three times as much per dollar, not ten times; but total impact cost, per dollar times dollars, still rises faster than the order.}}{97}{figure.caption.37}\protected@file@percent }
\newlabel{fig:06-impact}{{6.3}{97}{Square-root market impact for a stock with 2\% daily volatility, from Equation~\eqref {eq:06-impact} with $Y = 1$. Ten times the order size costs about three times as much per dollar, not ten times; but total impact cost, per dollar times dollars, still rises faster than the order}{figure.caption.37}{}}
