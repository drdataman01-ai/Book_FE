\@writefile{toc}{\contentsline {subsection}{\numberline {8.1.2}The dividend discount model}{100}{subsection.8.1.2}\protected@file@percent }
\newlabel{eq:07-gordon}{{8.1}{100}{The dividend discount model}{equation.8.1.1}{}}
\newlabel{eq:07-gordon-yield}{{8.2}{100}{The dividend discount model}{equation.8.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces The Gordon growth model for a market paying a \$3 dividend next year, with dividends growing 4\% a year. Lowering the required return from 7\% to 6\% raises the price from \$100 to \$150 and lowers the dividend yield from 3\% to 2\%. High prices and low yields go with low expected returns.}}{100}{figure.caption.37}\protected@file@percent }
\newlabel{fig:07-gordon}{{8.1}{100}{The Gordon growth model for a market paying a \$3 dividend next year, with dividends growing 4\% a year. Lowering the required return from 7\% to 6\% raises the price from \$100 to \$150 and lowers the dividend yield from 3\% to 2\%. High prices and low yields go with low expected returns}{figure.caption.37}{}}
