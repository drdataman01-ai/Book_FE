\@writefile{toc}{\contentsline {subsection}{\numberline {8.1.5}Real and nominal}{101}{subsection.8.1.5}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {8.2}How it works}{101}{section.8.2}\protected@file@percent }
\newlabel{sec:07-how}{{8.2}{101}{How it works}{section.8.2}{}}
\newlabel{eq:07-identity}{{8.3}{102}{How it works}{equation.8.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.2}{\ignorespaces Two shapes of the yield curve (illustrative). Normally, long-term yields exceed short-term ones and the term spread is positive. Before recessions the curve often flattens or inverts.}}{102}{figure.caption.38}\protected@file@percent }
\newlabel{fig:07-curve}{{8.2}{102}{Two shapes of the yield curve (illustrative). Normally, long-term yields exceed short-term ones and the term spread is positive. Before recessions the curve often flattens or inverts}{figure.caption.38}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces The Campbell--Shiller identity in words. A high price relative to dividends must be followed by low returns, fast dividend growth or a permanently high ratio. Return predictability is the first branch.}}{102}{figure.caption.39}\protected@file@percent }
\newlabel{fig:07-identity}{{8.3}{102}{The Campbell--Shiller identity in words. A high price relative to dividends must be followed by low returns, fast dividend growth or a permanently high ratio. Return predictability is the first branch}{figure.caption.39}{}}
