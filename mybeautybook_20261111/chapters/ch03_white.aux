\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Overlapping observations. Each observation in a regression of five-year returns covers 60 months, and each starts one month after the last. Consecutive observations share 59 of their 60 months, so they carry almost the same information.}}{66}{figure.caption.29}\protected@file@percent }
\newlabel{fig:03-overlap}{{4.8}{66}{Overlapping observations. Each observation in a regression of five-year returns covers 60 months, and each starts one month after the last. Consecutive observations share 59 of their 60 months, so they carry almost the same information}{figure.caption.29}{}}
