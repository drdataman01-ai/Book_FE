\@writefile{toc}{\contentsline {section}{\numberline {4.1}Foundations: distributions, regression and factor models}{57}{section.4.1}\protected@file@percent }
\newlabel{sec:03-foundations}{{4.1}{57}{Foundations: distributions, regression and factor models}{section.4.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.1}Describing a distribution}{57}{subsection.4.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces The four moments of a distribution. Each panel compares the standard normal distribution (solid) with one that differs in a single respect. (a)~The mean sets the center. (b)~The variance sets the spread. (c)~Negative skewness lengthens the left tail, so large losses are more likely than large gains of the same size. (d)~Higher kurtosis puts more weight in the tails: the normal distribution has kurtosis 3, the fat-tailed one shown has kurtosis 9. Panels (c) and (d) keep the mean and variance of the normal distribution.}}{57}{figure.caption.22}\protected@file@percent }
\newlabel{fig:03-moments}{{4.1}{57}{The four moments of a distribution. Each panel compares the standard normal distribution (solid) with one that differs in a single respect. (a)~The mean sets the center. (b)~The variance sets the spread. (c)~Negative skewness lengthens the left tail, so large losses are more likely than large gains of the same size. (d)~Higher kurtosis puts more weight in the tails: the normal distribution has kurtosis 3, the fat-tailed one shown has kurtosis 9. Panels (c) and (d) keep the mean and variance of the normal distribution}{figure.caption.22}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.2}Linear regression}{58}{subsection.4.1.2}\protected@file@percent }
\newlabel{sec:03-regression}{{4.1.2}{58}{Linear regression}{subsection.4.1.2}{}}
\newlabel{eq:03-ols}{{4.1}{58}{Linear regression}{equation.4.1.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Homoskedastic and heteroskedastic errors around the same true line, $y = 1 + 3x$, shown with simulated data. On the left, the scatter around the line has the same width everywhere, so the dashed bands run parallel to the line. On the right, the scatter grows with $x$, so the bands fan out. The fitted line is unbiased in both cases, but on the right the usual standard error understates the uncertainty. After Kuo (2025, Figure 15.4).}}{58}{figure.caption.23}\protected@file@percent }
\newlabel{fig:03-hetero-scatter}{{4.2}{58}{Homoskedastic and heteroskedastic errors around the same true line, $y = 1 + 3x$, shown with simulated data. On the left, the scatter around the line has the same width everywhere, so the dashed bands run parallel to the line. On the right, the scatter grows with $x$, so the bands fan out. The fitted line is unbiased in both cases, but on the right the usual standard error understates the uncertainty. After Kuo (2025, Figure 15.4)}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Two ways regression residuals break the textbook assumptions, shown with simulated data. In panel~(a) the errors are independent, but their spread, shown by the shaded band of plus or minus two standard deviations, triples during a crisis. In panel~(b) the spread is constant, but each error is strongly correlated with the one before it, so positive and negative errors arrive in long runs. In both cases the usual standard error is wrong.}}{59}{figure.caption.24}\protected@file@percent }
\newlabel{fig:03-residual-problems}{{4.3}{59}{Two ways regression residuals break the textbook assumptions, shown with simulated data. In panel~(a) the errors are independent, but their spread, shown by the shaded band of plus or minus two standard deviations, triples during a crisis. In panel~(b) the spread is constant, but each error is strongly correlated with the one before it, so positive and negative errors arrive in long runs. In both cases the usual standard error is wrong}{figure.caption.24}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.3}The capital asset pricing model}{59}{subsection.4.1.3}\protected@file@percent }
\newlabel{sec:03-capm}{{4.1.3}{59}{The capital asset pricing model}{subsection.4.1.3}{}}
\newlabel{eq:03-capm}{{4.2}{59}{The capital asset pricing model}{equation.4.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible.}}{60}{figure.caption.25}\protected@file@percent }
\newlabel{fig:03-alpha}{{4.4}{60}{Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible}{figure.caption.25}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1.4}Multifactor models}{60}{subsection.4.1.4}\protected@file@percent }
\newlabel{sec:03-factors}{{4.1.4}{60}{Multifactor models}{subsection.4.1.4}{}}
\newlabel{eq:03-ff3}{{4.3}{60}{Multifactor models}{equation.4.1.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative.}}{61}{figure.caption.26}\protected@file@percent }
\newlabel{fig:03-sml}{{4.5}{61}{The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative}{figure.caption.26}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Stylized facts of financial returns}{61}{section.4.2}\protected@file@percent }
\newlabel{sec:03-facts}{{4.2}{61}{Stylized facts of financial returns}{section.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.6}{\ignorespaces Fat tails. Both distributions have a mean of zero and a standard deviation of one. (a)~On an ordinary scale the two look similar, although the fat-tailed distribution has a taller, narrower peak. (b)~The difference lies in the tails. Beyond three standard deviations, the fat-tailed curve (shaded) stays well above the normal one, which falls almost to zero; at four standard deviations it is about 16 times higher. A daily move of five standard deviations in either direction occurs about once in 7,000 years under the normal distribution, but about once every two years under the fat-tailed distribution shown, a Student-$t$ distribution with four degrees of freedom, which is a common model for daily returns.}}{62}{figure.caption.27}\protected@file@percent }
\newlabel{fig:03-tails}{{4.6}{62}{Fat tails. Both distributions have a mean of zero and a standard deviation of one. (a)~On an ordinary scale the two look similar, although the fat-tailed distribution has a taller, narrower peak. (b)~The difference lies in the tails. Beyond three standard deviations, the fat-tailed curve (shaded) stays well above the normal one, which falls almost to zero; at four standard deviations it is about 16 times higher. A daily move of five standard deviations in either direction occurs about once in 7,000 years under the normal distribution, but about once every two years under the fat-tailed distribution shown, a Student-$t$ distribution with four degrees of freedom, which is a common model for daily returns}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Simulated stock price paths from two MCMC algorithms, each showing 1,000 paths over 200 trading days from a starting price of \$100 (horizontal line). (a)~With Gibbs sampling, each day's return is drawn independently, and the paths spread evenly around the starting price. (b)~With the Metropolis--Hastings algorithm, each day's return depends on the previous day's, and a few paths rise far above the rest. Note the different vertical scales. Source: Kuo (2025), Figures 14.6 and 14.10.}}{63}{figure.caption.28}\protected@file@percent }
\newlabel{fig:03-mcmc-paths}{{4.7}{63}{Simulated stock price paths from two MCMC algorithms, each showing 1,000 paths over 200 trading days from a starting price of \$100 (horizontal line). (a)~With Gibbs sampling, each day's return is drawn independently, and the paths spread evenly around the starting price. (b)~With the Metropolis--Hastings algorithm, each day's return depends on the previous day's, and a few paths rise far above the rest. Note the different vertical scales. Source: Kuo (2025), Figures 14.6 and 14.10}{figure.caption.28}{}}
