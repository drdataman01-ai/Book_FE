\newlabel{eq:01-sr}{{1.5}{13}{The Sharpe ratio}{equation.1.1.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.2}{\ignorespaces The Sharpe ratio is the slope of a line from the risk-free rate. Leverage moves a portfolio along its line, raising or lowering both excess return and volatility, but does not change the slope. A better strategy lies on a steeper line.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:01-sharpe-slope}{{1.2}{13}{The Sharpe ratio is the slope of a line from the risk-free rate. Leverage moves a portfolio along its line, raising or lowering both excess return and volatility, but does not change the slope. A better strategy lies on a steeper line}{figure.caption.7}{}}
