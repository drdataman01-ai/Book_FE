\@writefile{lot}{\contentsline {table}{\numberline {1.1}{\ignorespaces The same 16-year record measured annually, monthly and daily. The expected excess return is 10\% a year and the volatility is 20\% a year, so the annual Sharpe ratio is 0.5. The daily figures assume 252 trading days a year.}}{18}{table.caption.9}\protected@file@percent }
\newlabel{tab:01-frequency}{{1.1}{18}{The same 16-year record measured annually, monthly and daily. The expected excess return is 10\% a year and the volatility is 20\% a year, so the annual Sharpe ratio is 0.5. The daily figures assume 252 trading days a year}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1.4}{\ignorespaces What a 10-year record can show. The gray curve is the range of Sharpe ratios a strategy with no skill produces over different decades, and the blue curve is the same for a strategy with a true Sharpe ratio of 0.5. The shaded tail is the 6\% of decades in which the useless strategy beats 0.5 by luck.}}{20}{figure.caption.10}\protected@file@percent }
\newlabel{fig:01-ten-year}{{1.4}{20}{What a 10-year record can show. The gray curve is the range of Sharpe ratios a strategy with no skill produces over different decades, and the blue curve is the same for a strategy with a true Sharpe ratio of 0.5. The shaded tail is the 6\% of decades in which the useless strategy beats 0.5 by luck}{figure.caption.10}{}}
