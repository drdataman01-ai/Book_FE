\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces One year's excess return on the stock market, assuming an expected excess return of 7\% and volatility of 20\%. The blue band covers the middle two-thirds of years, from $-13$\% to 27\%; the gray area is the 36\% of years with a negative excess return.}}{12}{figure.caption.6}\protected@file@percent }
\newlabel{fig:01-oneyear}{{1.1}{12}{One year's excess return on the stock market, assuming an expected excess return of 7\% and volatility of 20\%. The blue band covers the middle two-thirds of years, from $-13$\% to 27\%; the gray area is the 36\% of years with a negative excess return}{figure.caption.6}{}}
