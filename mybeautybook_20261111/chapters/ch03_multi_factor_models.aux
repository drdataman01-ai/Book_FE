\@writefile{toc}{\contentsline {section}{\numberline {3.3}Stylized Facts of Financial Returns and $t$-Statistic Failures}{48}{section.3.3}\protected@file@percent }
\newlabel{sec:03-facts}{{3.3}{48}{Stylized Facts of Financial Returns and $t$-Statistic Failures}{section.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.7}{\ignorespaces Fat tails. Both distributions have a mean of zero and a standard deviation of one. (a)~On an ordinary scale the two look similar, although the fat-tailed distribution has a taller, narrower peak. (b)~The difference lies in the tails. Beyond three standard deviations, the fat-tailed curve (shaded) stays well above the normal one, which falls almost to zero; at four standard deviations it is about 16 times higher. A daily move of five standard deviations in either direction occurs about once in 7,000 years under the normal distribution, but about once every two years under the fat-tailed distribution shown, a Student-$t$ distribution with four degrees of freedom, which is a common model for daily returns.}}{49}{figure.caption.20}\protected@file@percent }
\newlabel{fig:03-tails}{{3.7}{49}{Fat tails. Both distributions have a mean of zero and a standard deviation of one. (a)~On an ordinary scale the two look similar, although the fat-tailed distribution has a taller, narrower peak. (b)~The difference lies in the tails. Beyond three standard deviations, the fat-tailed curve (shaded) stays well above the normal one, which falls almost to zero; at four standard deviations it is about 16 times higher. A daily move of five standard deviations in either direction occurs about once in 7,000 years under the normal distribution, but about once every two years under the fat-tailed distribution shown, a Student-$t$ distribution with four degrees of freedom, which is a common model for daily returns}{figure.caption.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3.1}{\ignorespaces Stylized Facts, the Assumptions They Break, and Their Remedies}}{49}{table.caption.21}\protected@file@percent }
