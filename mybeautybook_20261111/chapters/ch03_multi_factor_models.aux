\@writefile{toc}{\contentsline {subsection}{\numberline {3.2.1}Contemporaneous Linear Variance Partitioning}{45}{subsection.3.2.1}\protected@file@percent }
\newlabel{eq:03-vardec}{{3.7}{45}{Contemporaneous Linear Variance Partitioning}{equation.3.2.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.6}{\ignorespaces Splitting total variance into systematic and idiosyncratic parts with Equation~\eqref  {eq:03-vardec}. Each stock has a market beta of 1.2 and a residual standard deviation of 8\% a month, and the market's standard deviation is 4.5\% a month. Diversification leaves the systematic variance unchanged but divides the idiosyncratic variance by 100, so the systematic share, which equals the regression's $R^2$, rises from about 31\% to about 98\%. The numbers are illustrative.}}{46}{figure.caption.19}\protected@file@percent }
\newlabel{fig:03-vardec}{{3.6}{46}{Splitting total variance into systematic and idiosyncratic parts with Equation~\eqref {eq:03-vardec}. Each stock has a market beta of 1.2 and a residual standard deviation of 8\% a month, and the market's standard deviation is 4.5\% a month. Diversification leaves the systematic variance unchanged but divides the idiosyncratic variance by 100, so the systematic share, which equals the regression's $R^2$, rises from about 31\% to about 98\%. The numbers are illustrative}{figure.caption.19}{}}
