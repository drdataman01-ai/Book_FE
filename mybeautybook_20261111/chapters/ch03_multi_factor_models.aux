\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.1}Describing a Distribution}{40}{subsection.3.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces The four moments of a distribution. Each panel compares the standard normal distribution (solid) with one that differs in a single respect. (a)~The mean sets the center. (b)~The variance sets the spread. (c)~Negative skewness lengthens the left tail, so large losses are more likely than large gains of the same size. (d)~Higher kurtosis puts more weight in the tails: the normal distribution has kurtosis 3, the fat-tailed one shown has kurtosis 9. Panels (c) and (d) keep the mean and variance of the normal distribution.}}{41}{figure.caption.14}\protected@file@percent }
\newlabel{fig:03-moments}{{3.1}{41}{The four moments of a distribution. Each panel compares the standard normal distribution (solid) with one that differs in a single respect. (a)~The mean sets the center. (b)~The variance sets the spread. (c)~Negative skewness lengthens the left tail, so large losses are more likely than large gains of the same size. (d)~Higher kurtosis puts more weight in the tails: the normal distribution has kurtosis 3, the fat-tailed one shown has kurtosis 9. Panels (c) and (d) keep the mean and variance of the normal distribution}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.2}Linear Regression and OLS Assumptions}{41}{subsection.3.1.2}\protected@file@percent }
\newlabel{sec:03-regression}{{3.1.2}{41}{Linear Regression and OLS Assumptions}{subsection.3.1.2}{}}
\newlabel{eq:03-ols}{{3.2}{41}{Linear Regression and OLS Assumptions}{equation.3.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Homoskedastic and heteroskedastic errors around the same true line, $y = 1 + 3x$, shown with simulated data. On the left, the scatter around the line has the same width everywhere, so the dashed bands run parallel to the line. On the right, the scatter grows with $x$, so the bands fan out. The fitted line is unbiased in both cases, but on the right the usual standard error understates the uncertainty. After Kuo (2025, Figure 15.4).}}{42}{figure.caption.15}\protected@file@percent }
\newlabel{fig:03-hetero-scatter}{{3.2}{42}{Homoskedastic and heteroskedastic errors around the same true line, $y = 1 + 3x$, shown with simulated data. On the left, the scatter around the line has the same width everywhere, so the dashed bands run parallel to the line. On the right, the scatter grows with $x$, so the bands fan out. The fitted line is unbiased in both cases, but on the right the usual standard error understates the uncertainty. After Kuo (2025, Figure 15.4)}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.3}The Capital Asset Pricing Model (CAPM)}{42}{subsection.3.1.3}\protected@file@percent }
\newlabel{sec:03-capm}{{3.1.3}{42}{The Capital Asset Pricing Model (CAPM)}{subsection.3.1.3}{}}
\newlabel{eq:03-capm}{{3.3}{42}{The Capital Asset Pricing Model (CAPM)}{equation.3.1.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Two ways regression residuals break the textbook assumptions, shown with simulated data. In panel~(a) the errors are independent, but their spread, shown by the shaded band of plus or minus two standard deviations, triples during a crisis. In panel~(b) the spread is constant, but each error is strongly correlated with the one before it, so positive and negative errors arrive in long runs. In both cases the usual standard error is wrong.}}{43}{figure.caption.16}\protected@file@percent }
\newlabel{fig:03-residual-problems}{{3.3}{43}{Two ways regression residuals break the textbook assumptions, shown with simulated data. In panel~(a) the errors are independent, but their spread, shown by the shaded band of plus or minus two standard deviations, triples during a crisis. In panel~(b) the spread is constant, but each error is strongly correlated with the one before it, so positive and negative errors arrive in long runs. In both cases the usual standard error is wrong}{figure.caption.16}{}}
\newlabel{eq:03-capm-ts}{{3.4}{43}{The Capital Asset Pricing Model (CAPM)}{equation.3.1.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.4}Multi-Factor Architectures and the Factor Zoo}{43}{subsection.3.1.4}\protected@file@percent }
\newlabel{sec:03-factors}{{3.1.4}{43}{Multi-Factor Architectures and the Factor Zoo}{subsection.3.1.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible.}}{44}{figure.caption.17}\protected@file@percent }
\newlabel{fig:03-alpha}{{3.4}{44}{Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.5}{\ignorespaces The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative.}}{44}{figure.caption.18}\protected@file@percent }
\newlabel{fig:03-sml}{{3.5}{44}{The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative}{figure.caption.18}{}}
\newlabel{eq:03-ff3}{{3.5}{44}{Multi-Factor Architectures and the Factor Zoo}{equation.3.1.5}{}}
