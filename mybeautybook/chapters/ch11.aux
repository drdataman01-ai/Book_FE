\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Profit on the worked example's carry trade against the spot rate a year later. The trade earns \$40,000 if the Australian dollar is unchanged, breaks even at the UIP forecast of \$0.673, and loses \$65,000 if the currency falls 10\%.}}{50}{figure.caption.12}\protected@file@percent }
\newlabel{fig:06-carry}{{3.1}{50}{Profit on the worked example's carry trade against the spot rate a year later. The trade earns \$40,000 if the Australian dollar is unchanged, breaks even at the UIP forecast of \$0.673, and loses \$65,000 if the currency falls 10\%}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.2}How it works}{50}{section.3.2}\protected@file@percent }
\newlabel{sec:06-how}{{3.2}{50}{How it works}{section.3.2}{}}
\newlabel{eq:06-fama}{{3.4}{50}{How it works}{equation.3.2.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Three readings of the Fama regression. Under UIP ($b = 1$), a currency with a higher interest rate falls by its interest advantage. Under a random walk ($b = 0$), it is expected not to move. The typical estimate ($b \approx -0.9$, Froot and Thaler 1990) implies that it rises instead.}}{51}{figure.caption.13}\protected@file@percent }
\newlabel{fig:06-fama}{{3.2}{51}{Three readings of the Fama regression. Under UIP ($b = 1$), a currency with a higher interest rate falls by its interest advantage. Under a random walk ($b = 0$), it is expected not to move. The typical estimate ($b \approx -0.9$, Froot and Thaler 1990) implies that it rises instead}{figure.caption.13}{}}
