\@writefile{lof}{\contentsline {figure}{\numberline {16.2}{\ignorespaces Net return against one-way trading cost, from the turnover and gross returns in the table. Each line falls at a rate of four times the strategy's turnover; it crosses zero at the break-even cost. Value's line is nearly flat and crosses zero off the chart, at about 4\%.}}{200}{figure.caption.48}\protected@file@percent }
\newlabel{fig:17-breakeven}{{16.2}{200}{Net return against one-way trading cost, from the turnover and gross returns in the table. Each line falls at a rate of four times the strategy's turnover; it crosses zero at the break-even cost. Value's line is nearly flat and crosses zero off the chart, at about 4\%}{figure.caption.48}{}}
