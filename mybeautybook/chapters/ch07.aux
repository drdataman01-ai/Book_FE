\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Response of each estimator to a single 5\% move on day 10 when volatility is otherwise 1\% per day. The 22-day window raises its estimate by a fixed amount for exactly 22 days and then drops back abruptly when the shock leaves the window, even though nothing happened in the market that day. EWMA reacts more strongly at first, because yesterday receives the largest weight, and then lets the shock fade gradually.}}{104}{figure.caption.28}\protected@file@percent }
\newlabel{fig:10-ewma-shock}{{7.3}{104}{Response of each estimator to a single 5\% move on day 10 when volatility is otherwise 1\% per day. The 22-day window raises its estimate by a fixed amount for exactly 22 days and then drops back abruptly when the shock leaves the window, even though nothing happened in the market that day. EWMA reacts more strongly at first, because yesterday receives the largest weight, and then lets the shock fade gradually}{figure.caption.28}{}}
\newlabel{eq:10-arch}{{7.2}{104}{ARCH}{equation.7.1.2}{}}
\newlabel{eq:10-archq}{{7.3}{104}{ARCH}{equation.7.1.3}{}}
