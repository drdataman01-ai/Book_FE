\newlabel{eq:04-ols}{{4.1}{59}{Linear Regression and OLS Assumptions}{equation.4.1.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.2}Risk and Expected Return}{60}{section.4.2}\protected@file@percent }
\newlabel{sec:04-decomposition}{{4.2}{60}{Risk and Expected Return}{section.4.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.1}The CAPM: One Source of Priced Risk}{60}{subsection.4.2.1}\protected@file@percent }
\newlabel{sec:04-capm}{{4.2.1}{60}{The CAPM: One Source of Priced Risk}{subsection.4.2.1}{}}
\newlabel{eq:04-capm}{{4.2}{60}{The CAPM: One Source of Priced Risk}{equation.4.2.2}{}}
\newlabel{eq:04-capm-ts}{{4.3}{61}{The CAPM: One Source of Priced Risk}{equation.4.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible.}}{61}{figure.caption.17}\protected@file@percent }
\newlabel{fig:04-alpha}{{4.2}{61}{Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible}{figure.caption.17}{}}
\newlabel{eq:04-vardec-capm}{{4.4}{61}{The CAPM: One Source of Priced Risk}{equation.4.2.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Splitting total variance into systematic and idiosyncratic parts with Equation~\eqref  {eq:04-vardec-capm}. Each stock has a market beta of 1.2 and a residual standard deviation of 8\% a month, and the market's standard deviation is 4.5\% a month. Diversification leaves the systematic variance unchanged but divides the idiosyncratic variance by 100, so the systematic share, which equals the regression's $R^2$, rises from about 31\% to about 98\%. The numbers are illustrative.}}{62}{figure.caption.18}\protected@file@percent }
\newlabel{fig:04-vardec}{{4.3}{62}{Splitting total variance into systematic and idiosyncratic parts with Equation~\eqref {eq:04-vardec-capm}. Each stock has a market beta of 1.2 and a residual standard deviation of 8\% a month, and the market's standard deviation is 4.5\% a month. Diversification leaves the systematic variance unchanged but divides the idiosyncratic variance by 100, so the systematic share, which equals the regression's $R^2$, rises from about 31\% to about 98\%. The numbers are illustrative}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2.2}The Three-Factor Model: Decomposing What the Market Leaves Behind}{62}{subsection.4.2.2}\protected@file@percent }
\newlabel{sec:04-factors}{{4.2.2}{62}{The Three-Factor Model: Decomposing What the Market Leaves Behind}{subsection.4.2.2}{}}
\newlabel{eq:04-ff3}{{4.5}{62}{The Three-Factor Model: Decomposing What the Market Leaves Behind}{equation.4.2.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative.}}{63}{figure.caption.19}\protected@file@percent }
\newlabel{fig:04-sml}{{4.4}{63}{The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative}{figure.caption.19}{}}
