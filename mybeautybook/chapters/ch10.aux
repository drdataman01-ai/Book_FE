\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces A GARCH forecast reverting to its long-run level, from the worked example. After a 3\% fall the forecast for tomorrow is 27.7\% a year; it then decays toward 15.9\%, losing half of the gap every 34 trading days.}}{114}{figure.caption.29}\protected@file@percent }
\newlabel{fig:10-garch}{{9.2}{114}{A GARCH forecast reverting to its long-run level, from the worked example. After a 3\% fall the forecast for tomorrow is 27.7\% a year; it then decays toward 15.9\%, losing half of the gap every 34 trading days}{figure.caption.29}{}}
