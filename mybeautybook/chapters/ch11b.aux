\@writefile{toc}{\contentsline {chapter}{\numberline {11}Claim: High-Interest Currencies Depreciate Enough to Offset Their Yield}{174}{chapter.11}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
