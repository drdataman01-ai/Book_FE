\@writefile{lof}{\contentsline {figure}{\numberline {20.1}{\ignorespaces A fair test lets every model see only the past. Rolling-origin evaluation. At each origin every model sees the same data up to that month and forecasts the next one; the origin then moves forward a month. No model ever sees the month it is forecasting.}}{296}{figure.caption.84}\protected@file@percent }
\newlabel{fig:21-rolling}{{20.1}{296}{A fair test lets every model see only the past. Rolling-origin evaluation. At each origin every model sees the same data up to that month and forecasts the next one; the origin then moves forward a month. No model ever sees the month it is forecasting}{figure.caption.84}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20.2}{\ignorespaces A small forecasting gain takes decades of monthly data to prove. The expected Diebold--Mariano statistic for the worked example's 5\% gain, as the evaluation sample grows. It reaches 1.96 only after about 384 months; a two-year post-cutoff window gives about 0.5.}}{296}{figure.caption.85}\protected@file@percent }
\newlabel{fig:21-dm}{{20.2}{296}{A small forecasting gain takes decades of monthly data to prove. The expected Diebold--Mariano statistic for the worked example's 5\% gain, as the evaluation sample grows. It reaches 1.96 only after about 384 months; a two-year post-cutoff window gives about 0.5}{figure.caption.85}{}}
