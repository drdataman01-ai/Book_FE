\newlabel{ch:18}{{18}{210}{Claim: Low-Risk Stocks Beat High-Risk Stocks}{chapter.18}{}}
\@writefile{toc}{\contentsline {section}{\numberline {18.1}Foundations: beta, the CAPM and the security market line}{211}{section.18.1}\protected@file@percent }
\newlabel{sec:18-foundations}{{18.1}{211}{Foundations: beta, the CAPM and the security market line}{section.18.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {18.1.1}Beta, the CAPM and the security market line}{211}{subsection.18.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {18.1.2}Alpha}{211}{subsection.18.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18.1}{\ignorespaces The security market line in the worked example. The CAPM line runs from the risk-free rate of 3\% through the market at a beta of 1. Stock A lies above it (positive alpha) and stock B below it (negative alpha), so the line through A and B is flatter than the CAPM predicts.}}{212}{figure.caption.50}\protected@file@percent }
\newlabel{fig:18-sml}{{18.1}{212}{The security market line in the worked example. The CAPM line runs from the risk-free rate of 3\% through the market at a beta of 1. Stock A lies above it (positive alpha) and stock B below it (negative alpha), so the line through A and B is flatter than the CAPM predicts}{figure.caption.50}{}}
\@writefile{toc}{\contentsline {section}{\numberline {18.2}How it works}{212}{section.18.2}\protected@file@percent }
\newlabel{sec:18-how}{{18.2}{212}{How it works}{section.18.2}{}}
\newlabel{eq:18-bab}{{18.1}{212}{How it works}{equation.18.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18.2}{\ignorespaces Building a BAB portfolio from the worked example. Per dollar of capital, it holds \$1.67 of the low-beta stock ($\beta _L = 0.6$) and shorts \$0.67 of the high-beta stock ($\beta _H = 1.5$). Each leg then carries a beta exposure of 1, in opposite directions, so the portfolio's beta is zero.}}{213}{figure.caption.51}\protected@file@percent }
\newlabel{fig:18-bab}{{18.2}{213}{Building a BAB portfolio from the worked example. Per dollar of capital, it holds \$1.67 of the low-beta stock ($\beta _L = 0.6$) and shorts \$0.67 of the high-beta stock ($\beta _H = 1.5$). Each leg then carries a beta exposure of 1, in opposite directions, so the portfolio's beta is zero}{figure.caption.51}{}}
