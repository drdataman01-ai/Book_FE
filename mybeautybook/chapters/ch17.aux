\newlabel{ch:18}{{14}{195}{Claim: Low-Risk Stocks Beat High-Risk Stocks}{chapter.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {14.1}Foundations: beta, the CAPM and the security market line}{196}{section.14.1}\protected@file@percent }
\newlabel{sec:18-foundations}{{14.1}{196}{Foundations: beta, the CAPM and the security market line}{section.14.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {14.1.1}Beta, the CAPM and the security market line}{196}{subsection.14.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {14.1.2}Alpha}{196}{subsection.14.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14.1}{\ignorespaces Low-beta stocks have done better, and high-beta stocks worse, than the CAPM predicts. The security market line in the worked example. The CAPM line runs from the risk-free rate of 3\% through the market at a beta of 1. Stock A lies above it (positive alpha) and stock B below it (negative alpha), so the line through A and B is flatter than the CAPM predicts.}}{197}{figure.caption.51}\protected@file@percent }
\newlabel{fig:18-sml}{{14.1}{197}{Low-beta stocks have done better, and high-beta stocks worse, than the CAPM predicts. The security market line in the worked example. The CAPM line runs from the risk-free rate of 3\% through the market at a beta of 1. Stock A lies above it (positive alpha) and stock B below it (negative alpha), so the line through A and B is flatter than the CAPM predicts}{figure.caption.51}{}}
\@writefile{toc}{\contentsline {section}{\numberline {14.2}How it works}{197}{section.14.2}\protected@file@percent }
\newlabel{sec:18-how}{{14.2}{197}{How it works}{section.14.2}{}}
\newlabel{eq:18-bab}{{14.1}{198}{How it works}{equation.14.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14.2}{\ignorespaces Betting against beta borrows to scale up low-beta stocks and scales down high-beta ones until the market's moves cancel. Building a BAB portfolio from the worked example. Per dollar of capital, it holds \$1.67 of the low-beta stock ($\beta _L = 0.6$) and shorts \$0.67 of the high-beta stock ($\beta _H = 1.5$). Each leg then carries a beta exposure of 1, in opposite directions, so the portfolio's beta is zero.}}{198}{figure.caption.52}\protected@file@percent }
\newlabel{fig:18-bab}{{14.2}{198}{Betting against beta borrows to scale up low-beta stocks and scales down high-beta ones until the market's moves cancel. Building a BAB portfolio from the worked example. Per dollar of capital, it holds \$1.67 of the low-beta stock ($\beta _L = 0.6$) and shorts \$0.67 of the high-beta stock ($\beta _H = 1.5$). Each leg then carries a beta exposure of 1, in opposite directions, so the portfolio's beta is zero}{figure.caption.52}{}}
