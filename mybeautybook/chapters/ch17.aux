\newlabel{ch:18}{{17}{206}{Claim: Low-Risk Stocks Beat High-Risk Stocks}{chapter.17}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.1}Foundations: beta, the CAPM and the security market line}{207}{section.17.1}\protected@file@percent }
\newlabel{sec:18-foundations}{{17.1}{207}{Foundations: beta, the CAPM and the security market line}{section.17.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.1}Beta, the CAPM and the security market line}{207}{subsection.17.1.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.2}Alpha}{207}{subsection.17.1.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.1}{\ignorespaces The security market line in the worked example. The CAPM line runs from the risk-free rate of 3\% through the market at a beta of 1. Stock A lies above it (positive alpha) and stock B below it (negative alpha), so the line through A and B is flatter than the CAPM predicts.}}{208}{figure.caption.52}\protected@file@percent }
\newlabel{fig:18-sml}{{17.1}{208}{The security market line in the worked example. The CAPM line runs from the risk-free rate of 3\% through the market at a beta of 1. Stock A lies above it (positive alpha) and stock B below it (negative alpha), so the line through A and B is flatter than the CAPM predicts}{figure.caption.52}{}}
\@writefile{toc}{\contentsline {section}{\numberline {17.2}How it works}{208}{section.17.2}\protected@file@percent }
\newlabel{sec:18-how}{{17.2}{208}{How it works}{section.17.2}{}}
\newlabel{eq:18-bab}{{17.1}{208}{How it works}{equation.17.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.2}{\ignorespaces Building a BAB portfolio from the worked example. Per dollar of capital, it holds \$1.67 of the low-beta stock ($\beta _L = 0.6$) and shorts \$0.67 of the high-beta stock ($\beta _H = 1.5$). Each leg then carries a beta exposure of 1, in opposite directions, so the portfolio's beta is zero.}}{209}{figure.caption.53}\protected@file@percent }
\newlabel{fig:18-bab}{{17.2}{209}{Building a BAB portfolio from the worked example. Per dollar of capital, it holds \$1.67 of the low-beta stock ($\beta _L = 0.6$) and shorts \$0.67 of the high-beta stock ($\beta _H = 1.5$). Each leg then carries a beta exposure of 1, in opposite directions, so the portfolio's beta is zero}{figure.caption.53}{}}
