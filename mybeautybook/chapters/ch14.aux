\@writefile{lof}{\contentsline {figure}{\numberline {13.2}{\ignorespaces The delta-hedged call seller's P\&L over one day in the worked example. The seller earns \$0.063 of theta if the index is unchanged, breaks even on a move of about 1.35 points either way, and loses \$0.25 on a 3-point move. The loss grows with the square of the move.}}{164}{figure.caption.40}\protected@file@percent }
\newlabel{fig:14-pnl}{{13.2}{164}{The delta-hedged call seller's P\&L over one day in the worked example. The seller earns \$0.063 of theta if the index is unchanged, breaks even on a move of about 1.35 points either way, and loses \$0.25 on a 3-point move. The loss grows with the square of the move}{figure.caption.40}{}}
