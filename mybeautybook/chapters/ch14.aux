\@writefile{toc}{\contentsline {chapter}{\numberline {17}Claim: Delta Hedging Removes Option Risk}{226}{chapter.17}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{ch:14}{{17}{226}{Claim: Delta Hedging Removes Option Risk}{chapter.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.1}{\ignorespaces The call option in the story. The fund manager pays the bank \$4.50 per share today for the right to buy the stock at \$100 in three months. If the stock rises, the option protects her, and without a hedge the bank bears the loss. If the stock falls, she loses only the premium, which the bank keeps. The bank hedges by holding delta, 0.56 shares per option, so that small moves in the stock change its shares and the option it owes by the same amount.}}{226}{figure.caption.58}\protected@file@percent }
\newlabel{fig:14-story}{{17.1}{226}{The call option in the story. The fund manager pays the bank \$4.50 per share today for the right to buy the stock at \$100 in three months. If the stock rises, the option protects her, and without a hedge the bank bears the loss. If the stock falls, she loses only the premium, which the bank keeps. The bank hedges by holding delta, 0.56 shares per option, so that small moves in the stock change its shares and the option it owes by the same amount}{figure.caption.58}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17.1}{\ignorespaces The value of the call option at three stock prices.}}{227}{table.caption.59}\protected@file@percent }
\newlabel{tab:14-delta}{{17.1}{227}{The value of the call option at three stock prices}{table.caption.59}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.2}{\ignorespaces How the bank follows delta along two possible paths of the stock. The bank starts with 0.56 shares for each option it has sold. When the stock rises, the option becomes more likely to be used and its delta rises, so the bank buys more shares. When the stock falls, the delta falls, so the bank sells some. At expiry, the bank holds one share if the option will be used and none if it will not.}}{227}{figure.caption.60}\protected@file@percent }
\newlabel{fig:14-hedge}{{17.2}{227}{How the bank follows delta along two possible paths of the stock. The bank starts with 0.56 shares for each option it has sold. When the stock rises, the option becomes more likely to be used and its delta rises, so the bank buys more shares. When the stock falls, the delta falls, so the bank sells some. At expiry, the bank holds one share if the option will be used and none if it will not}{figure.caption.60}{}}
