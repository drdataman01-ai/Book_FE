\newlabel{tab:14-payoff}{{17.2}{229}{Payoffs at expiry for the call in the story, with a strike of \$100 and a premium of \$4.50. Profits are after the premium. The last column shows what a put with the same strike would pay}{table.caption.61}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.2}Put--call parity}{229}{subsection.17.1.2}\protected@file@percent }
\newlabel{eq:14-parity}{{17.2}{229}{Put--call parity}{equation.17.1.2}{}}
\newlabel{eq:14-parity-example}{{17.3}{229}{Put--call parity}{equation.17.1.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.3}Black--Scholes--Merton}{229}{subsection.17.1.3}\protected@file@percent }
\newlabel{sec:14-bsm}{{17.1.3}{229}{Black--Scholes--Merton}{subsection.17.1.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17.3}{\ignorespaces A covered call and a cash-secured put with a strike of \$100 are the same position. Both cost \$95.51 today and are worth the same at expiry.}}{230}{table.caption.62}\protected@file@percent }
\newlabel{tab:14-parity}{{17.3}{230}{A covered call and a cash-secured put with a strike of \$100 are the same position. Both cost \$95.51 today and are worth the same at expiry}{table.caption.62}{}}
\newlabel{eq:14-bs}{{17.4}{230}{Black--Scholes--Merton}{equation.17.1.4}{}}
\newlabel{eq:14-d}{{17.5}{230}{Black--Scholes--Merton}{equation.17.1.5}{}}
\newlabel{eq:14-bs-example}{{17.6}{230}{Black--Scholes--Merton}{equation.17.1.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.3}{\ignorespaces An option's value curve bends, which is why its hedge must keep changing. The Greeks of the call in the story, with a strike of \$100 and a 4\% interest rate. The solid navy curve is the option's Black--Scholes value with 20\% volatility and three months to expiry. Delta is its slope, 0.56 at a stock price of \$100, and gamma is how fast that slope changes: the curve bends, so delta rises from 0.18 at \$90 to 0.87 at \$110. Vega is how much the curve rises when volatility rises: at 30\% volatility, the dotted curve, the price at \$100 is \$1.97 higher. Theta is how much the curve falls as time passes: with one month left, the gray curve, the price at \$100 is \$2.02 lower. As expiry approaches, the curve falls toward the payoff at expiry.}}{231}{figure.caption.63}\protected@file@percent }
\newlabel{fig:14-bs}{{17.3}{231}{An option's value curve bends, which is why its hedge must keep changing. The Greeks of the call in the story, with a strike of \$100 and a 4\% interest rate. The solid navy curve is the option's Black--Scholes value with 20\% volatility and three months to expiry. Delta is its slope, 0.56 at a stock price of \$100, and gamma is how fast that slope changes: the curve bends, so delta rises from 0.18 at \$90 to 0.87 at \$110. Vega is how much the curve rises when volatility rises: at 30\% volatility, the dotted curve, the price at \$100 is \$1.97 higher. Theta is how much the curve falls as time passes: with one month left, the gray curve, the price at \$100 is \$2.02 lower. As expiry approaches, the curve falls toward the payoff at expiry}{figure.caption.63}{}}
