\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.6}Delta hedging}{232}{subsection.17.1.6}\protected@file@percent }
\newlabel{eq:14-taylor}{{17.7}{232}{Delta hedging}{equation.17.1.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17.5}{\ignorespaces One day of the bank's delta hedge, by Equation~\eqref  {eq:14-taylor}. The bank owes the option and holds 0.56 shares, so its net result is the change in its shares minus the change in the option.}}{233}{table.caption.65}\protected@file@percent }
\newlabel{tab:14-taylor}{{17.5}{233}{One day of the bank's delta hedge, by Equation~\eqref {eq:14-taylor}. The bank owes the option and holds 0.56 shares, so its net result is the change in its shares minus the change in the option}{table.caption.65}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.7}The hedging P\&L}{233}{subsection.17.1.7}\protected@file@percent }
\newlabel{eq:14-pnl}{{17.8}{233}{The hedging P\&L}{equation.17.1.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {17.6}{\ignorespaces The bank's hedged profit or loss over one day, by Equation~\eqref  {eq:14-pnl}, with $\tfrac  {1}{2}\Gamma S^2 \approx 197$ and $\sigma ^2 \Delta t \approx 0.00011$.}}{233}{table.caption.66}\protected@file@percent }
\newlabel{tab:14-pnl}{{17.6}{233}{The bank's hedged profit or loss over one day, by Equation~\eqref {eq:14-pnl}, with $\tfrac {1}{2}\Gamma S^2 \approx 197$ and $\sigma ^2 \Delta t \approx 0.00011$}{table.caption.66}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {17.1.8}Discrete hedging}{233}{subsection.17.1.8}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17.4}{\ignorespaces A hedged option seller earns a little on quiet days and loses on big moves in either direction. The bank's delta-hedged profit or loss over one day, by Equation~\eqref  {eq:14-pnl}, for the call in the story. The bank earns \$0.022 if the stock is unchanged, breaks even on a move of about \$1.05 either way, and loses \$0.156 on a \$3 move. The loss grows with the square of the move.}}{234}{figure.caption.67}\protected@file@percent }
\newlabel{fig:14-pnl}{{17.4}{234}{A hedged option seller earns a little on quiet days and loses on big moves in either direction. The bank's delta-hedged profit or loss over one day, by Equation~\eqref {eq:14-pnl}, for the call in the story. The bank earns \$0.022 if the stock is unchanged, breaks even on a move of about \$1.05 either way, and loses \$0.156 on a \$3 move. The loss grows with the square of the move}{figure.caption.67}{}}
\newlabel{eq:14-kd}{{17.9}{234}{Discrete hedging}{equation.17.1.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17.5}{\ignorespaces Hedging more often shrinks the error, but only slowly. Hedging error in the Black--Scholes world, by the Kamal--Derman approximation, for a one-month at-the-money option at 20\% volatility. Hedging weekly leaves an error of about 41\% of the premium, daily about 18\%, and four times a day about 9\%. Each quadrupling of the frequency halves the error.}}{234}{figure.caption.68}\protected@file@percent }
\newlabel{fig:14-freq}{{17.5}{234}{Hedging more often shrinks the error, but only slowly. Hedging error in the Black--Scholes world, by the Kamal--Derman approximation, for a one-month at-the-money option at 20\% volatility. Hedging weekly leaves an error of about 41\% of the premium, daily about 18\%, and four times a day about 9\%. Each quadrupling of the frequency halves the error}{figure.caption.68}{}}
