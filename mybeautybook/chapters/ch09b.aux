\@writefile{toc}{\contentsline {subsection}{\numberline {9.2.1}Expected returns are estimated poorly}{148}{subsection.9.2.1}\protected@file@percent }
\newlabel{sec:12-estimation}{{9.2.1}{148}{Expected returns are estimated poorly}{subsection.9.2.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.2}{\ignorespaces Even decades of data pin down an investment's average return only loosely. The standard error of an average return with 20\% volatility. With ten years of data it is 6.3\% a year; even 90 years leave it at 2.1\%. Differences in expected return between similar assets are far smaller than this, so the optimizer's most important input is mostly noise.}}{148}{figure.caption.35}\protected@file@percent }
\newlabel{fig:12-se}{{9.2}{148}{Even decades of data pin down an investment's average return only loosely. The standard error of an average return with 20\% volatility. With ten years of data it is 6.3\% a year; even 90 years leave it at 2.1\%. Differences in expected return between similar assets are far smaller than this, so the optimizer's most important input is mostly noise}{figure.caption.35}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2.2}Risks are estimated much better}{148}{subsection.9.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2.3}The optimizer bets on differences in returns}{149}{subsection.9.2.3}\protected@file@percent }
\newlabel{sec:12-worked}{{9.2.3}{149}{The optimizer bets on differences in returns}{subsection.9.2.3}{}}
\newlabel{eq:12-two-weights}{{9.10}{149}{The optimizer bets on differences in returns}{equation.9.2.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2.4}A small error in the means flips the portfolio}{149}{subsection.9.2.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2.5}Similar assets diversify less}{149}{subsection.9.2.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces The less alike two assets are, the more mixing them reduces risk. Frontiers for the two assets of Section~\ref {sec:12-frontier-derivation}, A (8\%) and B (6\%), each with 20\% volatility, at three correlations. All three curves pass through the two assets. The lower the correlation, the further the curve bends to the left, so the same expected return comes with less risk. The dots mark the minimum-variance portfolio, half in each asset, whose volatility rises from 14.1\% at a correlation of 0 to 17.3\% at 0.5 and 19.5\% at 0.9.}}{149}{figure.caption.36}\protected@file@percent }
\newlabel{fig:12-frontier-rho}{{9.3}{149}{The less alike two assets are, the more mixing them reduces risk. Frontiers for the two assets of Section~\ref {sec:12-frontier-derivation}, A (8\%) and B (6\%), each with 20\% volatility, at three correlations. All three curves pass through the two assets. The lower the correlation, the further the curve bends to the left, so the same expected return comes with less risk. The dots mark the minimum-variance portfolio, half in each asset, whose volatility rises from 14.1\% at a correlation of 0 to 17.3\% at 0.5 and 19.5\% at 0.9}{figure.caption.36}{}}
\gdef \LT@iv {\LT@entry 
    {1}{106.09526pt}\LT@entry 
    {1}{200.19054pt}\LT@entry 
    {1}{194.19054pt}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.4}{\ignorespaces Past a certain point, the optimizer's apparent gains rest on bets that small estimation errors can reverse. The highest Sharpe ratio attainable from A and B as their correlation changes. Up to a correlation of 0.75, a higher correlation means less diversification, and the Sharpe ratio falls from 0.50 to 0.40, the ratio of A alone. Beyond 0.75 the optimizer shorts B to hedge A, and the Sharpe ratio rises again. That gain depends on knowing the expected returns exactly, which is why it rarely survives estimation error (Section~\ref {sec:12-estimation}).}}{150}{figure.caption.37}\protected@file@percent }
\newlabel{fig:12-sharpe-rho}{{9.4}{150}{Past a certain point, the optimizer's apparent gains rest on bets that small estimation errors can reverse. The highest Sharpe ratio attainable from A and B as their correlation changes. Up to a correlation of 0.75, a higher correlation means less diversification, and the Sharpe ratio falls from 0.50 to 0.40, the ratio of A alone. Beyond 0.75 the optimizer shorts B to hedge A, and the Sharpe ratio rises again. That gain depends on knowing the expected returns exactly, which is why it rarely survives estimation error (Section~\ref {sec:12-estimation})}{figure.caption.37}{}}
