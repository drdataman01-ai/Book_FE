\@writefile{toc}{\contentsline {subsection}{\numberline {14.1.6}The Merton model}{172}{subsection.14.1.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14.1}{\ignorespaces The Merton model. At maturity, debtholders receive the firm's asset value $V$ up to the face value of debt $F$, so debt pays $\min (V, F)$. Shareholders receive what is left, $\max (V - F, 0)$, the payoff of a call option on the firm's assets. If $V < F$, the firm defaults.}}{173}{figure.caption.41}\protected@file@percent }
\newlabel{fig:15-merton}{{14.1}{173}{The Merton model. At maturity, debtholders receive the firm's asset value $V$ up to the face value of debt $F$, so debt pays $\min (V, F)$. Shareholders receive what is left, $\max (V - F, 0)$, the payoff of a call option on the firm's assets. If $V < F$, the firm defaults}{figure.caption.41}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14.2}{\ignorespaces Decomposing the worked example's 2\% Baa spread. At Moody's long-run default and recovery rates, expected default losses account for 0.17 percentage points. The remaining 1.83 points pay for something else: risk, illiquidity or taxes.}}{173}{figure.caption.42}\protected@file@percent }
\newlabel{fig:15-decomp}{{14.2}{173}{Decomposing the worked example's 2\% Baa spread. At Moody's long-run default and recovery rates, expected default losses account for 0.17 percentage points. The remaining 1.83 points pay for something else: risk, illiquidity or taxes}{figure.caption.42}{}}
