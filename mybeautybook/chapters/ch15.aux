\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.1}The VIX}{46}{subsection.3.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces The put seller's profit at expiry in the worked example. Above the strike of 100 the seller keeps the \$2.14 premium; below the break-even of 97.86 the loss grows one for one with the fall. A 10\% fall costs \$7.86, about seventeen months of expected gains.}}{46}{figure.caption.19}\protected@file@percent }
\newlabel{fig:16-put}{{3.1}{46}{The put seller's profit at expiry in the worked example. Above the strike of 100 the seller keeps the \$2.14 premium; below the break-even of 97.86 the loss grows one for one with the fall. A 10\% fall costs \$7.86, about seventeen months of expected gains}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.2}How it works}{46}{section.3.2}\protected@file@percent }
\newlabel{sec:16-how}{{3.2}{46}{How it works}{section.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces A one-month at-the-money covered call against the index alone, using the worked example's prices. The call premium of \$2.47 caps the gain and cushions the loss by the same amount, so the covered call keeps almost all of the index's downside.}}{47}{figure.caption.20}\protected@file@percent }
\newlabel{fig:16-cc}{{3.2}{47}{A one-month at-the-money covered call against the index alone, using the worked example's prices. The call premium of \$2.47 caps the gain and cushions the loss by the same amount, so the covered call keeps almost all of the index's downside}{figure.caption.20}{}}
