\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces The put seller's profit at expiry in the worked example. Above the strike of 100 the seller keeps the \$2.14 premium; below the break-even of 97.86 the loss grows one for one with the fall. A 10\% fall costs \$7.86, about seventeen months of expected gains.}}{65}{figure.caption.18}\protected@file@percent }
\newlabel{fig:16-put}{{5.1}{65}{The put seller's profit at expiry in the worked example. Above the strike of 100 the seller keeps the \$2.14 premium; below the break-even of 97.86 the loss grows one for one with the fall. A 10\% fall costs \$7.86, about seventeen months of expected gains}{figure.caption.18}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}How it works}{65}{section.5.2}\protected@file@percent }
\newlabel{sec:16-how}{{5.2}{65}{How it works}{section.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces A one-month at-the-money covered call against the index alone, using the worked example's prices. The call premium of \$2.47 caps the gain and cushions the loss by the same amount, so the covered call keeps almost all of the index's downside.}}{66}{figure.caption.19}\protected@file@percent }
\newlabel{fig:16-cc}{{5.2}{66}{A one-month at-the-money covered call against the index alone, using the worked example's prices. The call premium of \$2.47 caps the gain and cushions the loss by the same amount, so the covered call keeps almost all of the index's downside}{figure.caption.19}{}}
