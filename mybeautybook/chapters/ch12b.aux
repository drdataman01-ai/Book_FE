\@writefile{lof}{\contentsline {figure}{\numberline {12.3}{\ignorespaces A forward rate from the worked example. A two-year yield of 5\% is equivalent to earning the one-year yield of 4\% in the first year and a rate locked in today, the forward rate of 6\%, in the second.}}{191}{figure.caption.46}\protected@file@percent }
\newlabel{fig:07-forward-diagram}{{12.3}{191}{A forward rate from the worked example. A two-year yield of 5\% is equivalent to earning the one-year yield of 4\% in the first year and a rate locked in today, the forward rate of 6\%, in the second}{figure.caption.46}{}}
