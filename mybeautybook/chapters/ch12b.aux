\@writefile{toc}{\contentsline {chapter}{\numberline {12}Claim: Forward Rates Predict Future Interest Rates}{187}{chapter.12}\protected@file@percent }
\@writefile{lof}{\addvspace {10\p@ }}
\@writefile{lot}{\addvspace {10\p@ }}
\newlabel{ch:07}{{12}{187}{Claim: Forward Rates Predict Future Interest Rates}{chapter.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.1}{\ignorespaces Long-term rates are usually above short-term rates, and the rare exceptions draw headlines. Long-term and short-term interest rates in the United States, 2000--2025 (top), and the term spread (bottom), defined as $i^{\mathrm  {long}} - i^{\mathrm  {short}}$, where $i^{\mathrm  {long}}$ is the 10-year Treasury yield and $i^{\mathrm  {short}}$ is the 3-month Treasury bill rate. The data are annual averages, and the shaded bands are recessions. The term spread was large in the early 2010s, when short rates were near zero, and it turned negative in 2023 and 2024, when short rates rose above long rates.}}{188}{figure.caption.44}\protected@file@percent }
\newlabel{fig:07-long-short}{{12.1}{188}{Long-term rates are usually above short-term rates, and the rare exceptions draw headlines. Long-term and short-term interest rates in the United States, 2000--2025 (top), and the term spread (bottom), defined as $i^{\mathrm {long}} - i^{\mathrm {short}}$, where $i^{\mathrm {long}}$ is the 10-year Treasury yield and $i^{\mathrm {short}}$ is the 3-month Treasury bill rate. The data are annual averages, and the shaded bands are recessions. The term spread was large in the early 2010s, when short rates were near zero, and it turned negative in 2023 and 2024, when short rates rose above long rates}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12.2}{\ignorespaces Forward rates have usually predicted higher interest rates than actually arrived. Forward rates and the yield curve in the United States, 2000--2025. Panel~(a) shows the 1-year and 2-year Treasury yields and the forward rate they imply for the following year, $f = (1 + y^{(2)})^2 / (1 + y^{(1)}) - 1$, where $y^{(n)}$ is the $n$-year yield. When the 2-year yield is above the 1-year yield, the forward rate is above both. Panel~(b) compares each forward rate with the 1-year yield that actually prevailed a year later. If forward rates were unbiased forecasts, the two lines would differ only by random errors. Instead, the forward rate was usually too high, most visibly from 2009 to 2015, when it kept predicting rises that did not come, and it badly missed the rapid rise in 2022. The data are approximate annual averages.}}{188}{figure.caption.45}\protected@file@percent }
\newlabel{fig:07-forward2}{{12.2}{188}{Forward rates have usually predicted higher interest rates than actually arrived. Forward rates and the yield curve in the United States, 2000--2025. Panel~(a) shows the 1-year and 2-year Treasury yields and the forward rate they imply for the following year, $f = (1 + y^{(2)})^2 / (1 + y^{(1)}) - 1$, where $y^{(n)}$ is the $n$-year yield. When the 2-year yield is above the 1-year yield, the forward rate is above both. Panel~(b) compares each forward rate with the 1-year yield that actually prevailed a year later. If forward rates were unbiased forecasts, the two lines would differ only by random errors. Instead, the forward rate was usually too high, most visibly from 2009 to 2015, when it kept predicting rises that did not come, and it badly missed the rapid rise in 2022. The data are approximate annual averages}{figure.caption.45}{}}
