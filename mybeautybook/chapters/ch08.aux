\newlabel{ch:11}{{8}{122}{Claim: Value-at-Risk Models Measure Risk Reliably}{chapter.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces What a 99\% one-day VaR of \$50 million means. Each bar is one day's profit or loss for a hypothetical trading book over one year, simulated from a normal distribution. The VaR line sits where losses are expected to fall below it on about 1 day in 100. Over 250 trading days the loss exceeds the VaR on 3 days, shown in orange, close to the 2.5 a correct model would produce.}}{122}{figure.caption.32}\protected@file@percent }
\newlabel{fig:11-var-intro}{{8.1}{122}{What a 99\% one-day VaR of \$50 million means. Each bar is one day's profit or loss for a hypothetical trading book over one year, simulated from a normal distribution. The VaR line sits where losses are expected to fall below it on about 1 day in 100. Over 250 trading days the loss exceeds the VaR on 3 days, shown in orange, close to the 2.5 a correct model would produce}{figure.caption.32}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.1}Foundations: VaR, expected shortfall and their properties}{123}{section.8.1}\protected@file@percent }
\newlabel{sec:11-foundations}{{8.1}{123}{Foundations: VaR, expected shortfall and their properties}{section.8.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1.1}Value at Risk}{123}{subsection.8.1.1}\protected@file@percent }
