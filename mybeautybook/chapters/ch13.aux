\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces The delta-hedged call seller's P\&L over one day in the worked example. The seller earns \$0.063 of theta if the index is unchanged, breaks even on a move of about 1.35 points either way, and loses \$0.25 on a 3-point move. The loss grows with the square of the move.}}{46}{figure.caption.13}\protected@file@percent }
\newlabel{fig:14-pnl}{{3.2}{46}{The delta-hedged call seller's P\&L over one day in the worked example. The seller earns \$0.063 of theta if the index is unchanged, breaks even on a move of about 1.35 points either way, and loses \$0.25 on a 3-point move. The loss grows with the square of the move}{figure.caption.13}{}}
