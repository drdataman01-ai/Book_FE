\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces Hedging error in the Black--Scholes world, by the Kamal--Derman approximation, for a one-month at-the-money option at 20\% volatility. Hedging weekly leaves an error of about 41\% of the premium, daily about 18\%, and four times a day about 9\%. Each quadrupling of the frequency halves the error.}}{45}{figure.caption.12}\protected@file@percent }
\newlabel{fig:14-freq}{{3.1}{45}{Hedging error in the Black--Scholes world, by the Kamal--Derman approximation, for a one-month at-the-money option at 20\% volatility. Hedging weekly leaves an error of about 41\% of the premium, daily about 18\%, and four times a day about 9\%. Each quadrupling of the frequency halves the error}{figure.caption.12}{}}
