\newlabel{sec:04-decomposition}{{3.2}{49}{Risk and Expected Return}{section.3.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2.1}The CAPM}{49}{subsection.3.2.1}\protected@file@percent }
\newlabel{sec:04-capm}{{3.2.1}{49}{The CAPM}{subsection.3.2.1}{}}
\newlabel{eq:04-capm}{{3.2}{49}{The CAPM}{equation.3.2.2}{}}
\newlabel{eq:04-capm-ts}{{3.3}{50}{The CAPM}{equation.3.2.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible.}}{50}{figure.caption.15}\protected@file@percent }
\newlabel{fig:04-alpha}{{3.2}{50}{Beta and alpha in a regression of a strategy's monthly excess returns on the market's. Beta is the slope of the fitted line; alpha is its height where the market's excess return is zero, the gap between the fitted line and a line with the same slope through the origin. Simulated data, with an alpha larger than any real strategy's so that it is visible}{figure.caption.15}{}}
\newlabel{eq:04-vardec-capm}{{3.4}{50}{The CAPM}{equation.3.2.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Splitting total variance into systematic and idiosyncratic parts with Equation~\eqref  {eq:04-vardec-capm}. Each stock has a market beta of 1.2 and a residual standard deviation of 8\% a month, and the market's standard deviation is 4.5\% a month. Diversification leaves the systematic variance unchanged but divides the idiosyncratic variance by 100, so the systematic share, which equals the regression's $R^2$, rises from about 31\% to about 98\%. The numbers are illustrative.}}{51}{figure.caption.16}\protected@file@percent }
\newlabel{fig:04-vardec}{{3.3}{51}{Splitting total variance into systematic and idiosyncratic parts with Equation~\eqref {eq:04-vardec-capm}. Each stock has a market beta of 1.2 and a residual standard deviation of 8\% a month, and the market's standard deviation is 4.5\% a month. Diversification leaves the systematic variance unchanged but divides the idiosyncratic variance by 100, so the systematic share, which equals the regression's $R^2$, rises from about 31\% to about 98\%. The numbers are illustrative}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.4}{\ignorespaces The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative.}}{52}{figure.caption.17}\protected@file@percent }
\newlabel{fig:04-sml}{{3.4}{52}{The security market line. The CAPM predicts that average excess returns rise in a straight line with beta, passing through zero at a beta of zero and through the market's excess return at a beta of one (solid line). Tests that sort stocks into portfolios by beta typically find a flatter line with a positive intercept (dashed line and dots), so low-beta stocks earn more than predicted and high-beta stocks earn less (Black, Jensen and Scholes 1972). The numbers are illustrative}{figure.caption.17}{}}
