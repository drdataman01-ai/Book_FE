\newlabel{ch:04}{{3}{46}{Claim: Size and Value Explain Returns That Beta Cannot}{chapter.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3.1}Foundations: Distributions and Regression}{47}{section.3.1}\protected@file@percent }
\newlabel{sec:04-foundations}{{3.1}{47}{Foundations: Distributions and Regression}{section.3.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1.1}Describing a Distribution}{47}{subsection.3.1.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces The four moments of a distribution. Each panel compares the standard normal distribution (solid) with one that differs in a single respect. (a)~The mean sets the center. (b)~The variance sets the spread. (c)~Negative skewness lengthens the left tail, so large losses are more likely than large gains of the same size. (d)~Higher kurtosis puts more weight in the tails: the normal distribution has kurtosis 3, the fat-tailed one shown has kurtosis 9. Panels (c) and (d) keep the mean and variance of the normal distribution.}}{48}{figure.caption.14}\protected@file@percent }
\newlabel{fig:04-moments}{{3.1}{48}{The four moments of a distribution. Each panel compares the standard normal distribution (solid) with one that differs in a single respect. (a)~The mean sets the center. (b)~The variance sets the spread. (c)~Negative skewness lengthens the left tail, so large losses are more likely than large gains of the same size. (d)~Higher kurtosis puts more weight in the tails: the normal distribution has kurtosis 3, the fat-tailed one shown has kurtosis 9. Panels (c) and (d) keep the mean and variance of the normal distribution}{figure.caption.14}{}}
