\newlabel{fig:07-curve}{{8.2}{124}{Two shapes of the yield curve (illustrative). Normally, long-term yields exceed short-term ones and the term spread is positive. Before recessions the curve often flattens or inverts}{figure.caption.44}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces The Campbell--Shiller identity in words. A high price relative to dividends must be followed by low returns, fast dividend growth or a permanently high ratio. Return predictability is the first branch.}}{125}{figure.caption.45}\protected@file@percent }
\newlabel{fig:07-identity}{{8.3}{125}{The Campbell--Shiller identity in words. A high price relative to dividends must be followed by low returns, fast dividend growth or a permanently high ratio. Return predictability is the first branch}{figure.caption.45}{}}
