\@writefile{lof}{\contentsline {figure}{\numberline {24.2}{\ignorespaces The Bonferroni threshold for a two-sided test at a 5\% family-wise level, as the number of tests grows. It rises from 1.96 for one test to 2.81 for 10, 3.48 for 100 and 4.06 for 1,000.}}{286}{figure.caption.80}\protected@file@percent }
\newlabel{fig:25-bonf}{{24.2}{286}{The Bonferroni threshold for a two-sided test at a 5\% family-wise level, as the number of tests grows. It rises from 1.96 for one test to 2.81 for 10, 3.48 for 100 and 4.06 for 1,000}{figure.caption.80}{}}
