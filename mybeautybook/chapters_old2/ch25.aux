\@writefile{lof}{\contentsline {figure}{\numberline {24.1}{\ignorespaces Power to detect a true Sharpe ratio at $t^* = 1.96$, by years of data. Reaching 80\% power takes 31 years at a Sharpe ratio of 0.5, 49 years at 0.4 and 87 years at 0.3. With 20 years, a real Sharpe ratio of 0.4 is detected only 43\% of the time.}}{285}{figure.caption.79}\protected@file@percent }
\newlabel{fig:25-power}{{24.1}{285}{Power to detect a true Sharpe ratio at $t^* = 1.96$, by years of data. Reaching 80\% power takes 31 years at a Sharpe ratio of 0.5, 49 years at 0.4 and 87 years at 0.3. With 20 years, a real Sharpe ratio of 0.4 is detected only 43\% of the time}{figure.caption.79}{}}
