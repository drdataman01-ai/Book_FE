\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Bias and variance. Each dot is a forecast from the same model estimated on a different training sample, and the bullseye is the truth. Bias is how far the dots' average lies from the bullseye; variance is how widely the dots are scattered. The best model has both low (top left), but reducing one usually raises the other.}}{71}{figure.caption.22}\protected@file@percent }
\newlabel{fig:21-targets}{{5.1}{71}{Bias and variance. Each dot is a forecast from the same model estimated on a different training sample, and the bullseye is the truth. Bias is how far the dots' average lies from the bullseye; variance is how widely the dots are scattered. The best model has both low (top left), but reducing one usually raises the other}{figure.caption.22}{}}
\newlabel{eq:21-biasvar}{{5.4}{71}{Overfitting and the bias--variance trade-off}{equation.5.1.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces The bias--variance trade-off. The horizontal axis measures model complexity, roughly the number of parameters the model estimates; the vertical axis measures the model's expected forecast error on new data. Moving right, bias (dashed) falls and variance (dotted) rises, while the irreducible error (flat line) stays the same. Total error, their sum, is lowest at an intermediate complexity marked ``best.''}}{72}{figure.caption.23}\protected@file@percent }
\newlabel{fig:05-biasvar}{{5.2}{72}{The bias--variance trade-off. The horizontal axis measures model complexity, roughly the number of parameters the model estimates; the vertical axis measures the model's expected forecast error on new data. Moving right, bias (dashed) falls and variance (dotted) rises, while the irreducible error (flat line) stays the same. Total error, their sum, is lowest at an intermediate complexity marked ``best.''}{figure.caption.23}{}}
