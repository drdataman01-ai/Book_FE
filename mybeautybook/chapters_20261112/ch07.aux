\@writefile{lof}{\contentsline {figure}{\numberline {7.2}{\ignorespaces The standard error of an average return with 20\% volatility. With ten years of data it is 6.3\% a year; even 90 years leave it at 2.1\%. Differences in expected return between similar assets are far smaller than this, so the optimizer's most important input is mostly noise.}}{107}{figure.caption.39}\protected@file@percent }
\newlabel{fig:19-se}{{7.2}{107}{The standard error of an average return with 20\% volatility. With ten years of data it is 6.3\% a year; even 90 years leave it at 2.1\%. Differences in expected return between similar assets are far smaller than this, so the optimizer's most important input is mostly noise}{figure.caption.39}{}}
\newlabel{eq:19-two-weights}{{7.12}{108}{Noisy inputs, unstable weights}{equation.7.2.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.3}{\ignorespaces Tangency weights in the worked example as the correlation between the two assets rises, with expected returns fixed at 8\% and 6\%. At a correlation of 0.5 the split is 71/29; B's weight reaches zero at 0.75; at 0.9 the optimizer holds 186\% in A and shorts 86\% of B.}}{108}{figure.caption.40}\protected@file@percent }
\newlabel{fig:19-weights}{{7.3}{108}{Tangency weights in the worked example as the correlation between the two assets rises, with expected returns fixed at 8\% and 6\%. At a correlation of 0.5 the split is 71/29; B's weight reaches zero at 0.75; at 0.9 the optimizer holds 186\% in A and shorts 86\% of B}{figure.caption.40}{}}
