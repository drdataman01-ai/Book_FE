\@writefile{toc}{\contentsline {subsection}{\numberline {7.1.2}The efficient frontier}{103}{subsection.7.1.2}\protected@file@percent }
\newlabel{sec:19-frontier}{{7.1.2}{103}{The efficient frontier}{subsection.7.1.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces The efficient frontier. Each gray dot is a single asset, and the curve shows the lowest volatility that any mix of the risky assets can achieve for each expected return. Only the upper half of the curve (solid) is efficient, because each portfolio on the lower half (dashed) is beaten by one directly above it with the same risk and a higher return. The open circle shows the same problem for a portfolio inside the curve: the arrow points to a frontier portfolio with the same volatility and a higher expected return. The two navy dots mark the global minimum-variance portfolio $\mathbf  {w}_{MV}$ of Equation~\eqref  {eq:19-minvar}, at the tip of the curve, and the tangency portfolio $\mathbf  {w}_T$ of Equation~\eqref  {eq:19-tangency}. When investors can also hold Treasury bills, the best combinations lie on the straight line from the origin through the tangency portfolio, whose slope is the highest attainable Sharpe ratio. A more risk-averse investor (high $\gamma $) holds part of wealth in bills, while a less risk-averse investor (low $\gamma $) borrows to hold more of the tangency portfolio. The numbers are illustrative.}}{104}{figure.caption.38}\protected@file@percent }
\newlabel{fig:19-frontier}{{7.1}{104}{The efficient frontier. Each gray dot is a single asset, and the curve shows the lowest volatility that any mix of the risky assets can achieve for each expected return. Only the upper half of the curve (solid) is efficient, because each portfolio on the lower half (dashed) is beaten by one directly above it with the same risk and a higher return. The open circle shows the same problem for a portfolio inside the curve: the arrow points to a frontier portfolio with the same volatility and a higher expected return. The two navy dots mark the global minimum-variance portfolio $\mathbf {w}_{MV}$ of Equation~\eqref {eq:19-minvar}, at the tip of the curve, and the tangency portfolio $\mathbf {w}_T$ of Equation~\eqref {eq:19-tangency}. When investors can also hold Treasury bills, the best combinations lie on the straight line from the origin through the tangency portfolio, whose slope is the highest attainable Sharpe ratio. A more risk-averse investor (high $\gamma $) holds part of wealth in bills, while a less risk-averse investor (low $\gamma $) borrows to hold more of the tangency portfolio. The numbers are illustrative}{figure.caption.38}{}}
\newlabel{sec:19-frontier-derivation}{{7.1.2}{104}{The efficient frontier}{figure.caption.38}{}}
